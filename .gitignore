# Dependencies and build output are generated by scripts/build.mjs.
node_modules/
lib/
*.tsbuildinfo

# Scratch root of the A/B experiment (fixture copies, isolated DSH homes,
# session stores, transcripts). Recreated by tests/compare/compare.mjs.
tests/compare/.compare-run/

# Latest-run aliases; the meaningful runs are RESULTS-<label>.* plus
# RESULTS-SUMMARY.md.
tests/compare/RESULTS.json
tests/compare/RESULTS.md
