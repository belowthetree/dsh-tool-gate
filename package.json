{
  "name": "dsh-tool-gate",
  "version": "0.1.0",
  "description": "Expose a small base toolset and let the model unlock the rest on demand: a discovery tool plus a selection tool, applied as a per-agent tool restriction that takes effect on the next step.",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "scripts/build.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc <2",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc <2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs --noEmit",
    "test": "node tests/all.mjs",
    "compare": "node tests/compare/compare.mjs",
    "compare:report": "node tests/compare/report.mjs"
  }
}
