{
  "name": "@belowthetree/dsh-tool-gate",
  "version": "0.3.2",
  "description": "Expose a small base toolset, let the model keep the tools it needs, and show the session's current tool surface in a composer-dock badge.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "scripts/build.mjs",
    "scripts/build-ci.mjs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "tools",
    "agent",
    "tool-gate"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belowthetree/dsh-tool-gate.git"
  },
  "homepage": "https://github.com/belowthetree/dsh-tool-gate#readme",
  "bugs": {
    "url": "https://github.com/belowthetree/dsh-tool-gate/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc <2",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc <2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@types/node": "^22.20.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:ci": "node scripts/build-ci.mjs",
    "typecheck": "node scripts/build.mjs --noEmit",
    "test": "node tests/all.mjs",
    "compare": "node tests/compare/compare.mjs",
    "compare:report": "node tests/compare/report.mjs"
  }
}
